---
import SectionHead from '../ui/SectionHead.astro';
import { HOME } from '../../i18n/home';
import { FAQ } from '../../data/faq';
import type { Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = HOME[lang].faq;
---
<section id="faq" class="l-section c-faq" aria-labelledby="faq-title">
  <div class="l-container c-faq__grid">
    <SectionHead id="faq-title" kicker={t.kicker} title={t.title} />
    <div class="c-faq__list">
      {FAQ[lang].map((qa, i) => (
        <details class="c-faq__item" data-reveal style={`--i:${i % 4}`} name="faq">
          <summary class="c-faq__q">
            <span>{qa.q}</span>
            <svg class="c-faq__icon" viewBox="0 0 8 8" aria-hidden="true" shape-rendering="crispEdges"><path fill="currentColor" d="M3 1h2v2h2v2H5v2H3V5H1V3h2z" /></svg>
          </summary>
          <p class="c-faq__a">{qa.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .c-faq { background: var(--night-950); }
  .c-faq__grid { display: grid; gap: var(--sp-6); }
  @media (min-width: 64rem) { .c-faq__grid { grid-template-columns: 0.8fr 1.2fr; gap: var(--sp-8); align-items: start; } .c-faq__grid > :first-child { position: sticky; top: 120px; } }
  .c-faq__list { display: grid; gap: var(--sp-3); }
  .c-faq__item { background: var(--night-800); box-shadow: 0 0 0 2px var(--ink), 0 0 0 4px var(--night-600), 0 0 0 6px var(--ink); }
  .c-faq__item[open] { box-shadow: 0 0 0 2px var(--ink), 0 0 0 4px var(--gold-600), 0 0 0 6px var(--ink); }
  .c-faq__q {
    list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: var(--sp-4);
    min-height: 56px; padding: 12px var(--sp-5);
    font: 700 1.1rem/1.3 var(--font-display); color: var(--gold-100);
  }
  .c-faq__q::-webkit-details-marker { display: none; }
  .c-faq__q:hover { color: var(--text); }
  .c-faq__icon { width: 14px; height: 14px; flex: none; color: var(--gold-300); transition: rotate var(--t-ui) steps(3); }
  .c-faq__item[open] .c-faq__icon { rotate: 45deg; }
  .c-faq__a { margin: 0; padding: 0 var(--sp-5) var(--sp-5); color: var(--muted); max-width: 65ch; }
</style>

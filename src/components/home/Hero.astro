---
import { Picture, getImage } from 'astro:assets';
import heroPoster from '../../assets/posters/hero.webp';
import logo from '../../assets/brand/logo-alpha.webp';
import { HOME } from '../../i18n/home';
import { HERO_LOOP } from '../../data/videos';
import { homeAnchor, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = HOME[lang].hero;
const logoImg = await getImage({ src: logo, format: 'webp', width: 942 });
---
<section class="c-hero" aria-labelledby="hero-title" data-hero>
  <div class="c-hero__media" aria-hidden="true">
    <Picture
      src={heroPoster}
      formats={['avif', 'webp']} fallbackFormat="webp"
      widths={[640, 960, 1280, 1920]}
      sizes="(max-aspect-ratio: 16/9) 178vh, 100vw"
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="sync"
      class="c-hero__poster"
    />
    <div class="c-hero__video-slot" data-hero-slot data-desktop={JSON.stringify(HERO_LOOP.desktop)} data-mobile={JSON.stringify(HERO_LOOP.mobile)}></div>
    <div class="c-hero__scrim"></div>
    <canvas class="c-hero__embers" data-embers width="0" height="0"></canvas>
  </div>

  <div class="c-hero__content">
    <h1 id="hero-title" class="c-hero__title">
      <span class="c-hero__logo" style={`--logo: url(${logoImg.src})`}>
        <img src={logoImg.src} alt="SpareForge" width="942" height="301" fetchpriority="high" decoding="async" />
      </span>
      <span class="u-sr">{t.h1Hidden}</span>
    </h1>
    <p class="c-hero__tagline">{t.tagline}</p>
    <div class="c-hero__ctas">
      <a class="p-btn p-btn--gold c-hero__join" href={homeAnchor(lang, 'alpha')}>
        <svg viewBox="0 0 8 8" aria-hidden="true" shape-rendering="crispEdges"><path fill="currentColor" d="M2 1h1v1h1v1h1v1h1v1H5v1H4v1H3v1H2z" /></svg>
        {t.join}
      </a>
      <button class="p-btn p-btn--game c-hero__trailer" type="button" data-open-trailer>
        <svg viewBox="0 0 8 8" aria-hidden="true" shape-rendering="crispEdges"><path fill="currentColor" d="M1 1h6v6H1zM2 2v4h4V2zM3 3h1v1h1v1H4v1H3z" /></svg>
        {t.trailer} <span class="c-hero__dur" aria-hidden="true">1:21</span>
      </button>
    </div>
    <ul class="c-hero__chips" aria-label={lang === 'de' ? 'Auf einen Blick' : 'At a glance'}>
      {t.chips.map((c, i) => <li class:list={['c-chip', { 'c-chip--alpha': i === 0 }]}>{c}</li>)}
    </ul>
  </div>

  <button class="c-hero__pause" type="button" hidden data-hero-pause data-label-pause={t.pause} data-label-play={t.play} aria-pressed="false">
    <svg class="i-pause" viewBox="0 0 8 8" aria-hidden="true" shape-rendering="crispEdges"><path fill="currentColor" d="M2 1h1v6H2zM5 1h1v6H5z" /></svg>
    <svg class="i-play" viewBox="0 0 8 8" aria-hidden="true" shape-rendering="crispEdges"><path fill="currentColor" d="M2 1h1v1h1v1h1v1h1v1H5v1H4v1H3v1H2z" /></svg>
    <span class="u-sr" data-hero-pause-label>{t.pause}</span>
  </button>
</section>

<style>
  .c-hero {
    position: relative; isolation: isolate; overflow: clip;
    min-height: clamp(560px, calc(100svh - 100px), 920px);
    display: grid; align-items: end;
    background: var(--night-950);
  }
  .c-hero__media { position: absolute; inset: 0; z-index: -1; }
  .c-hero__media :global(picture), .c-hero__media :global(img), .c-hero__media :global(video) {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 62% 40%;
  }
  .c-hero__video-slot :global(video) { opacity: 0; transition: opacity 900ms var(--ease-out); }
  .c-hero__video-slot :global(video.is-playing) { opacity: 1; }
  /* Scrim: dark at the bottom where the text sits (>= 70 % night under body copy), a vignette at the edges */
  .c-hero__scrim {
    position: absolute; inset: 0;
    background:
      radial-gradient(120% 90% at 50% 30%, transparent 30%, rgb(7 4 24 / 0.55) 75%, rgb(7 4 24 / 0.9) 100%),
      linear-gradient(to bottom, rgb(11 7 32 / 0.35) 0%, transparent 25%, rgb(11 7 32 / 0.55) 55%, rgb(11 7 32 / 0.92) 78%, var(--night-950) 100%);
  }
  /* Dithered bottom edge into the page */
  .c-hero__media::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 24px; background: var(--night-950);
    -webkit-mask: url('../../assets/ui/bayer-4.png') 0 0 / 8px 8px repeat-x, url('../../assets/ui/bayer-8.png') 0 8px / 8px 8px repeat-x, url('../../assets/ui/bayer-12.png') 0 16px / 8px 8px repeat-x;
    mask: url('../../assets/ui/bayer-4.png') 0 0 / 8px 8px repeat-x, url('../../assets/ui/bayer-8.png') 0 8px / 8px 8px repeat-x, url('../../assets/ui/bayer-12.png') 0 16px / 8px 8px repeat-x;
    image-rendering: pixelated;
  }
  .c-hero__embers { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; image-rendering: pixelated; }

  .c-hero__content {
    width: var(--container); margin-inline: auto;
    padding-block: clamp(96px, 16vh, 180px) clamp(56px, 9vh, 96px);
    display: grid; justify-items: center; text-align: center; gap: var(--sp-5);
  }
  .c-hero__title { margin: 0; }
  .c-hero__logo { position: relative; display: block; width: min(88vw, 620px); }
  .c-hero__logo img { width: 100%; height: auto; filter: drop-shadow(0 6px 0 var(--ink)) drop-shadow(0 18px 40px rgb(7 4 24 / 0.8)); }
  /* One specular sweep across the gold, masked by the logo's own alpha */
  .c-hero__logo::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(105deg, transparent 40%, rgb(255 255 240 / 0.85) 47%, rgb(255 255 240 / 0.85) 50%, transparent 57%) -150% 0 / 250% 100% no-repeat;
    mix-blend-mode: overlay;
    -webkit-mask: var(--logo) center / 100% 100% no-repeat; mask: var(--logo) center / 100% 100% no-repeat;
    opacity: 0;
  }
  :global(html.motion-ok) .c-hero__logo::after { animation: sweep 900ms var(--ease-out) 700ms 1 both; }
  @keyframes sweep { 0% { opacity: 1; background-position: -150% 0; } 99% { opacity: 1; } 100% { opacity: 0; background-position: 250% 0; } }

  .c-hero__tagline {
    max-width: 40ch; margin: 0; font-size: var(--fs-hero); line-height: 1.45; color: var(--text);
    text-shadow: 0 2px 0 var(--ink), 0 0 24px rgb(7 4 24 / 0.9);
  }
  .c-hero__ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--sp-4); margin-top: var(--sp-2); }
  .c-hero__join { --btn-h: 58px; font-size: 1.15rem; padding: 0 28px; }
  .c-hero__trailer { --btn-h: 58px; }
  .c-hero__dur { font: 400 0.7rem/1 var(--font-chip); color: var(--gold-100); padding: 3px 5px 2px; background: var(--ink); }
  .c-hero__chips { list-style: none; margin: var(--sp-2) 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }

  .c-hero__pause {
    position: absolute; right: var(--gutter); bottom: 28px; z-index: 2;
    width: 44px; height: 44px; display: grid; place-items: center; cursor: pointer;
    color: var(--gold-100); background: rgb(11 7 32 / 0.75); border: 0;
    box-shadow: inset 0 0 0 2px var(--gold-600), 0 0 0 2px var(--ink);
  }
  .c-hero__pause[hidden] { display: none; }
  .c-hero__pause svg { width: 16px; height: 16px; }
  .c-hero__pause .i-play { display: none; }
  .c-hero__pause[aria-pressed='true'] .i-play { display: block; }
  .c-hero__pause[aria-pressed='true'] .i-pause { display: none; }

  @media (min-width: 64rem) {
    .c-hero__content { justify-items: start; text-align: left; padding-block: 120px clamp(72px, 12vh, 128px); }
    .c-hero__logo { width: min(46vw, 640px); margin-left: -12px; }
    .c-hero__ctas, .c-hero__chips { justify-content: flex-start; }
    .c-hero__tagline { max-width: 34ch; }
    .c-hero__media :global(img), .c-hero__media :global(video) { object-position: 30% 45%; left: 18%; width: 82%; }
    .c-hero__scrim {
      background:
        linear-gradient(90deg, var(--night-950) 0%, rgb(11 7 32 / 0.92) 22%, rgb(11 7 32 / 0.55) 42%, transparent 62%),
        radial-gradient(90% 100% at 70% 40%, transparent 40%, rgb(7 4 24 / 0.75) 100%),
        linear-gradient(to bottom, rgb(11 7 32 / 0.5) 0%, transparent 18%, transparent 70%, var(--night-950) 100%);
    }
  }
  @media (max-width: 40rem) {
    .c-hero { min-height: clamp(560px, calc(100svh - 100px), 760px); }
    .c-hero__content { padding-block: 72px 56px; gap: var(--sp-4); }
    .c-hero__ctas { width: 100%; flex-direction: column; align-items: stretch; }
    .c-hero__ctas > * { width: 100%; }
    .c-hero__media :global(img), .c-hero__media :global(video) { object-position: 70% 35%; }
    .c-hero__pause { bottom: auto; top: 16px; }
  }
</style>

<script>
  import { skipHeavyMedia, motionOk } from '../../lib/motion';
  import { startEmbers } from '../../lib/embers';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const slot = hero?.querySelector<HTMLElement>('[data-hero-slot]');
  const pauseBtn = hero?.querySelector<HTMLButtonElement>('[data-hero-pause]');
  let video: HTMLVideoElement | null = null;
  let userPaused = false;
  let inView = true;

  function syncPlayback() {
    if (!video) return;
    if (userPaused || !inView || document.hidden || !motionOk()) video.pause();
    else video.play().catch(() => {});
  }

  function mountVideo() {
    if (!hero || !slot || video || skipHeavyMedia()) return;
    const set = JSON.parse((window.innerWidth < 768 ? slot.dataset.mobile : slot.dataset.desktop) ?? '[]') as { src: string; type: string }[];
    video = document.createElement('video');
    video.muted = true; video.loop = true; video.playsInline = true; video.preload = 'auto';
    video.setAttribute('muted', ''); video.setAttribute('playsinline', ''); video.setAttribute('aria-hidden', 'true'); video.tabIndex = -1;
    for (const s of set) { const el = document.createElement('source'); el.src = s.src; el.type = s.type; video.append(el); }
    video.addEventListener('playing', () => video?.classList.add('is-playing'), { once: true });
    video.addEventListener('error', () => { video?.remove(); video = null; pauseBtn && (pauseBtn.hidden = true); }, true);
    slot.append(video);
    if (pauseBtn) pauseBtn.hidden = false;
    syncPlayback();
  }

  if (hero) {
    const idle = (cb: () => void) => ('requestIdleCallback' in window ? requestIdleCallback(cb, { timeout: 2500 }) : setTimeout(cb, 1200));
    if (document.readyState === 'complete') idle(mountVideo);
    else addEventListener('load', () => idle(mountVideo), { once: true });

    new IntersectionObserver(([e]) => { inView = e.isIntersecting; syncPlayback(); }).observe(hero);
    document.addEventListener('visibilitychange', syncPlayback);

    pauseBtn?.addEventListener('click', () => {
      userPaused = !userPaused;
      pauseBtn.setAttribute('aria-pressed', String(userPaused));
      const label = pauseBtn.querySelector('[data-hero-pause-label]');
      if (label) label.textContent = userPaused ? pauseBtn.dataset.labelPlay! : pauseBtn.dataset.labelPause!;
      syncPlayback();
    });

    const canvas = hero.querySelector<HTMLCanvasElement>('[data-embers]');
    const stopEmbers = canvas ? startEmbers(canvas, hero) : null;

    addEventListener('sf:motion', ((e: CustomEvent<{ reduce: boolean }>) => {
      if (e.detail.reduce) {
        video?.remove(); video = null; if (pauseBtn) pauseBtn.hidden = true; stopEmbers?.();
      } else {
        mountVideo();
        if (canvas) startEmbers(canvas, hero);
      }
    }) as EventListener);
  }
</script>

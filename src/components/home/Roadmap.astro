---
import { getCollection } from 'astro:content';
import SectionHead from '../ui/SectionHead.astro';
import { HOME, ROADMAP } from '../../i18n/home';
import { ROUTES, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = HOME[lang].roadmap;
const r = ROADMAP[lang];
const posts = (await getCollection('devlog', (p) => p.data.lang === lang))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = new Intl.DateTimeFormat(lang === 'de' ? 'de-DE' : 'en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const slug = (id: string) => id.split('/').pop();
---
<section id="roadmap" class="l-section l-section--alt c-road p-dither-top" aria-labelledby="roadmap-title" style="--dither-color: var(--night-900)">
  <div class="l-container c-road__grid">
    <div>
      <SectionHead id="roadmap-title" kicker={t.kicker} title={t.title} lead={t.lead} />
      <ol class="c-track">
        <li class="c-track__stage c-track__stage--now" data-reveal>
          <h3 class="c-track__label"><span class="c-track__dot" aria-hidden="true"></span>{t.now}</h3>
          {r.now.map((v) => (
            <div class="c-track__ver">
              <span class="c-chip c-chip--gold">v{v.v}</span>
              <ul>{v.items.map((x) => <li>{x}</li>)}</ul>
            </div>
          ))}
        </li>
        <li class="c-track__stage c-track__stage--next" data-reveal>
          <h3 class="c-track__label"><span class="c-track__dot" aria-hidden="true"></span>{t.next}</h3>
          <p>{t.nextText}</p>
        </li>
        <li class="c-track__stage c-track__stage--later" data-reveal>
          <h3 class="c-track__label"><span class="c-track__dot" aria-hidden="true"></span>{t.later}</h3>
          <ul>{r.later.map((x) => <li>{x}</li>)}</ul>
        </li>
      </ol>
    </div>

    <aside class="c-devlog" aria-labelledby="devlog-title">
      <h3 id="devlog-title" class="c-devlog__title">{t.devlog}</h3>
      <ul class="c-devlog__list">
        {posts.map((p, i) => (
          <li data-reveal style={`--i:${i}`}>
            <a class="c-devlog__card p-refine" href={`${ROUTES.devlog[lang]}/${slug(p.id)}`}>
              <span class="c-devlog__meta"><time datetime={p.data.date.toISOString().slice(0, 10)}>{fmt.format(p.data.date)}</time> · v{p.data.version}</span>
              <span class="c-devlog__name">{p.data.title.replace(/^Devlog #\d+:\s*/, '')}</span>
              <span class="c-devlog__sum">{p.data.summary}</span>
            </a>
          </li>
        ))}
      </ul>
      <a class="p-btn p-btn--ghost p-btn--sm" href={ROUTES.devlog[lang]}>{t.allPosts} →</a>
    </aside>
  </div>
</section>

<style>
  .c-road__grid { display: grid; gap: var(--sp-8); }
  @media (min-width: 64rem) { .c-road__grid { grid-template-columns: 1.1fr 0.9fr; align-items: start; } }

  .c-track { list-style: none; margin: 0; padding: 0 0 0 28px; position: relative; display: grid; gap: var(--sp-6); }
  .c-track::before { content: ''; position: absolute; left: 7px; top: 8px; bottom: 8px; width: 4px; background: repeating-linear-gradient(var(--gold-600) 0 8px, transparent 8px 12px); }
  .c-track__stage { position: relative; }
  .c-track__label { display: flex; align-items: center; gap: 12px; font-size: var(--fs-xl); color: var(--gold-100); margin: 0 0 var(--sp-3) -28px; }
  .c-track__dot { width: 18px; height: 18px; flex: none; box-shadow: 0 0 0 2px var(--ink); }
  .c-track__stage--now .c-track__dot { background: var(--gold-300); box-shadow: 0 0 0 2px var(--ink), 0 0 16px 2px rgb(255 201 60 / 0.6); }
  .c-track__stage--next .c-track__dot { background: linear-gradient(90deg, var(--gold-300) 50%, var(--night-700) 50%); }
  .c-track__stage--later .c-track__dot { background: var(--night-700); box-shadow: inset 0 0 0 2px var(--gold-600), 0 0 0 2px var(--ink); }
  .c-track__stage p { color: var(--muted); margin: 0; }
  .c-track__ver { display: grid; grid-template-columns: auto 1fr; gap: 12px; align-items: start; margin-bottom: var(--sp-4); }
  .c-track ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; color: var(--muted); }
  .c-track ul li { padding-left: 16px; position: relative; }
  .c-track ul li::before { content: ''; position: absolute; left: 0; top: 0.65em; width: 6px; height: 6px; background: var(--gold-500); }
  .c-track__stage--later ul li::before { background: var(--refine-5); }

  .c-devlog { display: grid; gap: var(--sp-5); justify-items: start; }
  .c-devlog__title { font: 400 0.8rem/1 var(--font-chip); letter-spacing: 0.14em; text-transform: uppercase; color: var(--ember-300); }
  .c-devlog__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-4); width: 100%; }
  .c-devlog__card { display: grid; gap: 6px; padding: var(--sp-4) var(--sp-5); text-decoration: none; background: var(--night-800); box-shadow: 0 0 0 2px var(--ink), 0 0 0 4px var(--night-600), 0 0 0 6px var(--ink); }
  .c-devlog__card:hover { background: var(--night-700); }
  .c-devlog__meta { font: 400 0.68rem/1 var(--font-chip); color: var(--faint); letter-spacing: 0.04em; text-transform: uppercase; }
  .c-devlog__name { font: 700 1.15rem/1.25 var(--font-display); color: var(--gold-100); }
  .c-devlog__sum { color: var(--muted); font-size: var(--fs-sm); }
</style>

---
import { Image } from 'astro:assets';
import wordmark from '../../assets/brand/wordmark.png';
import { LINKS } from '../../site';
import { BUILD } from '../../data/build';
import { UI, ROUTES, homeAnchor, type Lang, type RouteKey } from '../../i18n';
import LangSwitch from './LangSwitch.astro';

interface Props { lang: Lang; route: RouteKey; alternates: { en: string; de: string } }
const { lang, alternates } = Astro.props;
const t = UI[lang].footer;
const n = UI[lang].nav;
const game = [
  [homeAnchor(lang, 'classes'), n.classes],
  [homeAnchor(lang, 'videos'), n.videos],
  [homeAnchor(lang, 'gallery'), n.gallery],
  [homeAnchor(lang, 'roadmap'), n.roadmap],
  [ROUTES.devlog[lang], 'Devlog'],
  [homeAnchor(lang, 'faq'), n.faq],
  [ROUTES.alpha[lang], n.join],
];
const community = [
  [LINKS.discord, 'Discord'],
  [LINKS.tiktok, 'TikTok'],
  [LINKS.instagram, 'Instagram'],
  [LINKS.youtube, 'YouTube'],
];
const legal = [
  [ROUTES.impressum[lang], t.impressum],
  [ROUTES.privacy[lang], t.privacy],
  [ROUTES.terms[lang], t.terms],
  [ROUTES.contact[lang], t.contact],
];
const motionLabel = lang === 'de'
  ? { on: 'Bewegung reduziert', hint: 'Videos, Funken und Einblendungen aus' }
  : { on: 'Motion reduced', hint: 'Turns off videos, embers and reveals' };
---
<footer class="c-foot">
  <div class="c-foot__body">
    <div class="l-container c-foot__grid">
      <div class="c-foot__brand">
        <Image src={wordmark} alt="SpareForge" width={240} class="c-foot__word" loading="lazy" />
        <p>{t.blurb}</p>
        <p class="c-foot__promise"><span class="c-chip">{t.promise}</span></p>
        <p class="c-foot__build"><span class="c-chip c-chip--alpha">{BUILD.stage} {BUILD.version}</span></p>
      </div>
      <nav class="c-foot__col" aria-label={t.game}>
        <h2>{t.game}</h2>
        <ul>{game.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
      </nav>
      <nav class="c-foot__col" aria-label={t.community}>
        <h2>{t.community}</h2>
        <ul>{community.map(([href, label]) => <li><a href={href} rel="noopener">{label}</a></li>)}</ul>
      </nav>
      <nav class="c-foot__col" aria-label={t.legal}>
        <h2>{t.legal}</h2>
        <ul>{legal.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
      </nav>
    </div>
    <div class="l-container c-foot__bottom">
      <button class="c-switch" type="button" role="switch" aria-checked="false" data-motion-toggle>
        <span class="c-switch__track" aria-hidden="true"><span class="c-switch__thumb"></span></span>
        <span class="c-switch__label">{t.motion}</span>
        <span class="u-sr">, {motionLabel.hint}</span>
      </button>
      <LangSwitch lang={lang} alternates={alternates} />
      <p class="c-foot__fine">
        © 2026 SpareForge · {t.rights} · <a href="https://godotengine.org" rel="noopener">{t.godot}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .c-foot { position: relative; margin-top: 0; background: var(--night-975); isolation: isolate; }
  .c-foot__body { background: var(--night-975); padding-block: var(--sp-7) var(--sp-6); box-shadow: 0 -2px 0 var(--ink); }
  .c-foot__grid { display: grid; gap: var(--sp-6); grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .c-foot__grid { grid-template-columns: 1fr 1fr 1fr; } .c-foot__brand { grid-column: 1 / -1; } }
  @media (min-width: 64rem) { .c-foot__grid { grid-template-columns: 1.6fr 1fr 1fr 1fr; } .c-foot__brand { grid-column: auto; } }
  .c-foot__word { width: 200px; height: auto; margin-bottom: var(--sp-4); }
  .c-foot__brand p { color: var(--muted); max-width: 34ch; margin-bottom: var(--sp-3); }
  .c-foot__col h2 { font: 400 0.75rem/1 var(--font-chip); letter-spacing: 0.14em; text-transform: uppercase; color: var(--ember-300); margin-bottom: var(--sp-4); }
  .c-foot__col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .c-foot__col a { display: inline-flex; align-items: center; min-height: 44px; padding-right: 8px; color: var(--muted); text-decoration: none; font-size: var(--fs-base); }
  .c-foot__col a:hover { color: var(--gold-100); text-decoration: underline; }
  .c-foot__bottom {
    margin-top: var(--sp-7); padding-top: var(--sp-5); box-shadow: 0 -2px 0 var(--night-700);
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-4) var(--sp-5);
  }
  .c-foot__fine { margin: 0; color: var(--faint); font-size: var(--fs-sm); flex: 1 1 320px; text-align: right; }
  .c-foot__fine a { color: var(--muted); display: inline-flex; align-items: center; min-height: 32px; }
  @media (max-width: 40rem) { .c-foot__fine { text-align: left; } }

  .c-switch { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; padding: 0; background: none; border: 0; cursor: pointer; color: var(--muted); }
  .c-switch__track { position: relative; width: 44px; height: 24px; background: var(--night-800); box-shadow: inset 0 0 0 2px var(--night-600), 0 0 0 2px var(--ink); }
  .c-switch__thumb { position: absolute; top: 4px; left: 4px; width: 16px; height: 16px; background: var(--muted); transition: transform var(--t-micro) steps(3), background var(--t-micro); }
  .c-switch[aria-checked='true'] .c-switch__track { background: var(--gold-600); }
  .c-switch[aria-checked='true'] .c-switch__thumb { transform: translateX(20px); background: var(--gold-100); }
  .c-switch:hover { color: var(--gold-100); }
</style>

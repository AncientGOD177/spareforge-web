---
import '@fontsource/pixelify-sans/600.css';
import '../styles/global.css';
import { LINKS } from '../site';
interface Props { title?: string; description?: string; image?: string }
const {
  title = 'SpareForge: a pixel action RPG',
  description = 'An original pixel-art action RPG built by one person. Six classes, twelve jobs, twenty regions, loot worth hunting and LAN co-op for up to four players. Free alpha.',
  image = '/img/og.jpg',
} = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
const og = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#120c2e" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <a class="brand" href="/" aria-label="SpareForge, home">SpareForge</a>
      <nav aria-label="Main">
        <a href="/#game">The game</a>
        <a href="/#screens">Screens</a>
        <a href="/#alpha">Alpha</a>
        <a class="nav-discord" href={LINKS.discord} rel="noopener">Discord</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="foot">
      <p>© 2026 SpareForge. Pixel art, music and sound made for the game.</p>
      <p><a href={LINKS.discord} rel="noopener">Discord</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a><a href="/impressum">Impressum</a></p>
    </footer>
  </body>
</html>

---
import Base from '../layouts/Base.astro';
import { LINKS } from '../site';
---
<Base title="Page not found · SpareForge" description="This page does not exist.">
  <section class="lost">
    <div class="wrap">
      <h1>Lost in the wastes</h1>
      <p>This page does not exist, or it moved. The forge is still burning at the front door.</p>
      <div class="cta">
        <a class="btn primary" href="/">Back to the forge</a>
        <a class="btn" href={LINKS.discord} rel="noopener">Join the Discord</a>
      </div>
    </div>
  </section>
</Base>

---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import bg from '../assets/gallery/gloomcap.webp';
import { LINKS } from '../site';
---
<Base lang="en" route="notFound" title="Page not found · SpareForge" description="This page does not exist." noindex>
  <section class="c-404">
    <Picture src={bg} formats={['avif', 'webp']} fallbackFormat="webp" widths={[640, 1280, 1920]} sizes="100vw" alt="" class="c-404__bg" loading="eager" />
    <div class="c-404__panel p-window">
      <p class="c-404__code" aria-hidden="true">404</p>
      <h1 class="c-404__title">Lost in the Mirewood</h1>
      <p>This page does not exist, or it moved. The forge is still burning at the front door.</p>
      <p lang="de" class="c-404__de">Diese Seite gibt es nicht (mehr). Die Schmiede brennt weiter auf der Startseite.</p>
      <div class="c-404__ctas">
        <a class="p-btn p-btn--gold" href="/">Back to the forge</a>
        <a class="p-btn p-btn--game" href="/de" lang="de">Zur Startseite</a>
        <a class="p-btn p-btn--ghost" href={LINKS.discord} rel="noopener">Discord</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .c-404 { position: relative; isolation: isolate; min-height: 72svh; display: grid; place-items: center; padding: var(--sp-9) var(--gutter); overflow: clip; }
  .c-404__bg { position: absolute; inset: 0; z-index: -1; }
  .c-404__bg :global(img), :global(.c-404__bg) { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.45) saturate(0.9); }
  .c-404__panel { width: min(560px, 100%); background: var(--ui-blue-900); display: grid; gap: var(--sp-3); padding: var(--sp-4); text-align: center; justify-items: center; }
  .c-404__code { margin: 0; font: 700 clamp(4rem, 14vw, 7rem)/1 var(--font-display); color: var(--gold-300); text-shadow: 0 6px 0 var(--bronze-900), 0 10px 0 var(--ink); }
  .c-404__title { font: 700 var(--fs-2xl)/1.1 var(--font-display); color: var(--gold-100); }
  .c-404__panel p { margin: 0; color: var(--muted); }
  .c-404__de { font-size: var(--fs-sm); color: var(--faint) !important; }
  .c-404__ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--sp-3); margin-top: var(--sp-3); }
</style>

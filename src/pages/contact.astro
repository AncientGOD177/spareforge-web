---
import Prose from '../layouts/Prose.astro';
import ContactForm from '../components/ContactForm.astro';
import { LINKS, CONTACT_EMAIL } from '../site';
---
<Prose lang="en" route="contact" title="Contact · SpareForge" heading="Contact" kicker="Get in touch" description="Contact the SpareForge developer by form or email.">
  <p>Questions about the game, press requests or anything legal: use the form or write to <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. The fastest place for bug reports and alpha keys is the Discord server.</p>
  <ContactForm lang="en" />
  <aside slot="aside" class="c-aside">
    <h2>Bugs and alpha keys</h2>
    <p>Bug reports, feedback and alpha keys are handled on Discord, where the whole tester group can see and confirm issues.</p>
    <a class="p-btn p-btn--game p-btn--sm" href={LINKS.discord} rel="noopener">Join the Discord</a>
    <p class="c-aside__warn">Never send your itch.io key by email or post it in public.</p>
  </aside>
</Prose>
<style>
  .c-aside { display: grid; gap: var(--sp-3); justify-items: start; padding: var(--sp-5); background: var(--night-900); box-shadow: 0 0 0 2px var(--ink), 0 0 0 4px var(--night-600), 0 0 0 6px var(--ink); }
  .c-aside h2 { font: 700 var(--fs-lg)/1.2 var(--font-display); color: var(--gold-100); }
  .c-aside p { margin: 0; color: var(--muted); }
  .c-aside__warn { font-size: var(--fs-sm); color: var(--ember-300) !important; }
</style>

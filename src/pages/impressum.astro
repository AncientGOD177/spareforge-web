---
import Prose from '../layouts/Prose.astro';
import { NAME, ADDRESS, CONTACT_EMAIL } from '../site';
import { ROUTES } from '../i18n';
---
<Prose lang="en" route="impressum" title="Legal Notice (Impressum) · SpareForge" heading="Legal Notice (Impressum)" kicker="Legal" description="Legal notice for spareforge.net according to German law.">
  <h2>Provider according to § 5 DDG</h2>
  <address>
    {NAME}<br />
    {ADDRESS.street}<br />
    {ADDRESS.zip} {ADDRESS.city}<br />
    {ADDRESS.country.en}
  </address>

  <h2>Contact</h2>
  <p>Email: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a><br />
  Contact form: <a href={ROUTES.contact.en}>spareforge.net/contact</a></p>

  <h2>Responsible for content according to § 18 (2) MStV</h2>
  <p>{NAME}, address as above.</p>

  <h2>Liability for links</h2>
  <p>This site links to external websites (for example Discord, TikTok, Instagram, YouTube and itch.io). We have no influence on their content and cannot accept liability for it. The respective provider is responsible for the content of linked pages.</p>

  <p class="note">The German version is the legally binding one: <a href={ROUTES.impressum.de}>Impressum (Deutsch)</a>.</p>
</Prose>

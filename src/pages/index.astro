---
import Base from '../layouts/Base.astro';
import { LINKS } from '../site';

// What the game is, as a reading list. Numbers live inside the sentences, not in a stat band.
const game = [
  ['Six classes, twelve jobs', 'Start as a Wanderer, choose a class, then master a second job: Vanguard, Sorcerer, Ranger, Luminary, Forgemaster or Shadowblade.'],
  ['Two kinds of levels', 'Base level up to 150 and a separate job level. Spend stat points and build the character your way.'],
  ['80+ skills', 'Every skill has its own effect, cast time and combo potential.'],
  ['Twenty regions', 'Meadows, frozen passes, crystal caves, ashen wastes, sunken ruins and dark catacombs.'],
  ['Bosses and Apex bosses', 'Field bosses, dungeon bosses and Apex fights with unique loot.'],
  ['Loot that rolls', 'Six rarities. Rare drops roll random prefixes and suffixes from Crude to Perfect.'],
  ['The forge', 'Refine, repair and reforge your gear until one line is perfect.'],
  ['Cards, pets and mounts', 'Slot monster cards, let a pet pick up your loot, ride from ponies to gryphons.'],
  ['LAN co-op', 'Play with up to four players on your home network.'],
];

// Boss shot lives in the hero, so the gallery starts with the rest. `wide` tiles span two columns on large screens.
const shots = [
  ['town_0', 'Forge Town', true],
  ['combat_knight_0', 'Close-quarters combat', false],
  ['coop_0', 'LAN co-op with friends', false],
  ['worldmap_0', 'The world map', true],
  ['gear_0', 'Gear with random affixes', false],
  ['mount_0', 'Mounts', false],
  ['u_reforge_0', 'The reforge window', false],
  ['creator_0', 'Character creation', false],
];

const store = [
  ['Steam', LINKS.steam],
  ['itch.io', LINKS.itch],
].filter(([, href]) => href);
---
<Base>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-inner">
      <h1 id="hero-title" class="logo">
        <img src="/img/logo.webp" alt="SpareForge Alpha" width="942" height="301" fetchpriority="high" />
      </h1>
      <p class="lead">A pixel action RPG in the spirit of the classic online RPGs, built from scratch by one person.</p>
      <div class="cta">
        <a class="btn primary" href={LINKS.discord} rel="noopener">Join the Discord</a>
        {store.map(([name, href]) => <a class="btn" href={href} rel="noopener">Get it on {name}</a>)}
        <a class="btn" href="#screens">See the game</a>
      </div>
      <figure class="window">
        <img src="/img/boss_0.webp" alt="An Apex boss fight at Skyreach Citadel" width="1280" height="720" />
      </figure>
    </div>
  </section>

  <div class="notice" role="note">
    <strong>Alpha build.</strong> Expect bugs, balance changes and the occasional save reset. Your feedback shapes the game.
  </div>

  <section id="game" class="split">
    <div class="wrap two">
      <div class="two-head">
        <h2>Forge your legend</h2>
        <p>Real-time combat, a deep job system and loot that keeps you hunting. Alone, or with three friends on the same network.</p>
      </div>
      <dl class="rows">
        {game.map(([term, text]) => (
          <div class="row">
            <dt>{term}</dt>
            <dd>{text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section id="screens">
    <div class="wrap">
      <h2>In the game</h2>
      <div class="shots">
        {shots.map(([file, caption, wide]) => (
          <figure class:list={['shot', { wide }]}>
            <img src={`/img/${file}.webp`} alt={caption} width="1280" height="720" loading="lazy" decoding="async" />
            <figcaption>{caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section id="alpha" class="split">
    <div class="wrap two">
      <div class="two-head">
        <h2>Where the alpha stands</h2>
        <p>SpareForge is in active development. This is what works today and what is still planned.</p>
      </div>
      <dl class="rows">
        <div class="row"><dt>Works today</dt><dd>Single-player and LAN co-op, keyboard and mouse.</dd></div>
        <div class="row"><dt>Planned</dt><dd>Online co-op over Steam before the beta, and in-app purchases later in the game's life. The alpha has none yet.</dd></div>
        <div class="row"><dt>Back up your saves</dt><dd>Alpha means bugs, balance changes and the occasional save reset.</dd></div>
      </dl>
    </div>
  </section>

  <section id="community" class="community">
    <div class="wrap">
      <h2>Join the forge on Discord</h2>
      <p>Report bugs, share your builds, vote on what comes next and find a co-op party.</p>
      <a class="btn primary" href={LINKS.discord} rel="noopener">Join the Discord</a>
    </div>
  </section>
</Base>
